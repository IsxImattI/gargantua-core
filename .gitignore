# Visual Studio user-specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.slnx.docstates

# Build output - klasicni Win32/x64 build folderji
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Ww][Ii][Nn]32/
